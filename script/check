#!/usr/bin/env python3

import hashlib
import json
import re
import struct
import sys
from datetime import datetime
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SLUG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
EXPECTED_CATEGORY_COUNT = 13
EXPECTED_PROMPT_CARD_COUNT = 541
EXPECTED_RECIPE_COUNT = 16
EXPECTED_CARDS_BY_CATEGORY = {
    "ui-interfaces": 73,
    "charts-infographics": 53,
    "posters-typography": 90,
    "products-ecommerce": 42,
    "brand-logos": 27,
    "architecture-spaces": 12,
    "photography-realism": 78,
    "illustration-art": 59,
    "characters-people": 31,
    "scenes-storytelling": 21,
    "history-classical-themes": 16,
    "documents-publishing": 11,
    "other-use-cases": 28,
}
REQUIRED_CATEGORY_KEYS = {"id", "title"}
REQUIRED_CATALOG_RECIPE_KEYS = {
    "id",
    "title",
    "task_family",
    "category",
    "path",
}
REQUIRED_PROMPT_CARD_KEYS = {
    "id",
    "title",
    "category",
    "task_family",
    "input_modes",
    "output_type",
    "aspect_ratio",
    "text_density",
    "tags",
    "path",
    "source_posture",
    "source_record",
    "rights",
    "sample_status",
    "linked_recipe",
}
REQUIRED_RECIPE_KEYS = {
    "schema_version",
    "id",
    "record_version",
    "status",
    "title",
    "task_family",
    "source_posture",
    "source_record",
    "recipe_markdown",
    "evidence_manifest",
    "profiles",
    "evidence_status",
}
ALLOWED_POSTURES = {
    "original",
    "attributed-rebuild",
    "translation",
    "frozen-source",
}
ALLOWED_EVIDENCE = {"placeholder", "recorded"}
ALLOWED_INPUT_MODES = {"text", "reference-image", "multiple-images", "sketch"}
ALLOWED_TEXT_DENSITY = {"none", "low", "medium", "high"}
ALLOWED_CARD_SAMPLE_STATUS = {"placeholder", "rendered"}
REQUIRED_CARD_HEADINGS_BEFORE_SAMPLE = (
    "## Use this when",
    "## Required inputs",
    "## Prompt",
    "## Variables",
    "## Negative constraints",
    "## Quick check",
)
CARD_SAMPLE_HEADINGS = {
    "placeholder": "## Placeholder Preview",
    "rendered": "## Rendered Sample",
}
CARD_SAMPLE_FIELD_LABELS = (
    "Sample status",
    "Generation surface",
    "Generated at",
    "Model",
    "Model version",
    "Seed",
    "Request parameters",
    "Request ID",
    "Exact prompt",
    "Output dimensions",
    "Output SHA-256",
    "Profile ID",
    "Promotion evidence",
    "Human inspection",
    "Known misses",
    "Rights and provenance",
)
REQUIRED_EVIDENCE_KEYS = {
    "schema_version",
    "recipe_id",
    "recipe_record_version",
    "status",
    "runs",
}
REQUIRED_RUN_KEYS = {
    "id",
    "kind",
    "generated_at",
    "surface",
    "model",
    "model_version",
    "seed",
    "request_parameters",
    "request_id",
    "prompt_file",
    "profile_id",
    "inputs",
    "output",
    "inspection",
    "promotion_evidence",
    "featured_in_readme",
    "rights",
}
REQUIRED_ASSET_KEYS = {"path", "sha256", "width", "height", "format"}
REQUIRED_RIGHTS_KEYS = {
    "input_rights",
    "creator_or_authorized_licensor",
    "license",
}
PROMOTION_METADATA_KEYS = {
    "model",
    "model_version",
    "seed",
    "request_parameters",
    "request_id",
}
MARKDOWN_LINK = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
SHA256 = re.compile(r"[0-9a-f]{64}")
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
UNRESOLVED_VARIABLE = re.compile(r"\{[A-Z][A-Z0-9_]*\}")
CARD_INPUT_DERIVATIVE = re.compile(r"input-([0-9]{2})-([a-z0-9]+(?:-[a-z0-9]+)*)\.webp")


def fail(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"missing file: {path.relative_to(ROOT)}")
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {path.relative_to(ROOT)}: {error}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path.relative_to(ROOT)}")
    return value


def require_relative_file(base: Path, value: str, label: str) -> Path:
    path = (base / value).resolve()
    try:
        path.relative_to(ROOT)
    except ValueError:
        fail(f"{label} escapes repository: {value}")
    if not path.is_file():
        fail(f"missing {label}: {path.relative_to(ROOT)}")
    return path


def require_keys(value: object, required: set[str], label: str) -> dict:
    if not isinstance(value, dict):
        fail(f"{label} must be an object")
    missing = required - value.keys()
    if missing:
        fail(f"{label} missing keys: {', '.join(sorted(missing))}")
    return value


def require_nonempty_string(value: object, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        fail(f"{label} must be a non-empty string")
    return value


def require_slug(value: object, label: str) -> str:
    slug = require_nonempty_string(value, label)
    if not SLUG.fullmatch(slug):
        fail(f"{label} must be a lowercase hyphenated slug")
    return slug


def check_source_reference(record: dict, base: Path, label: str) -> None:
    posture = record["source_posture"]
    source_record = record["source_record"]
    if posture == "original":
        if source_record is not None:
            fail(f"{label} original source_record must be null")
        return
    source_path = require_nonempty_string(source_record, f"{label} source_record")
    require_relative_file(base, source_path, f"{label} source record")


def require_card_sample_field(section: str, field: str, card_id: str) -> str:
    matches = re.findall(
        rf"^- {re.escape(field)}: (.+)$",
        section,
        re.MULTILINE,
    )
    if len(matches) != 1 or not matches[0].strip():
        fail(f"{card_id} Rendered Sample must contain one non-empty {field} field")
    return matches[0].strip()


def check_webp(path: Path, label: str) -> tuple[int, int]:
    data = path.read_bytes()
    if len(data) < 20 or data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        fail(f"{label} is not a WebP: {path.relative_to(ROOT)}")
    if struct.unpack("<I", data[4:8])[0] + 8 != len(data):
        fail(f"{label} has an invalid WebP RIFF size: {path.relative_to(ROOT)}")

    dimensions: tuple[int, int] | None = None
    has_image_payload = False
    offset = 12
    while offset + 8 <= len(data):
        chunk_type = data[offset : offset + 4]
        chunk_size = struct.unpack("<I", data[offset + 4 : offset + 8])[0]
        chunk_start = offset + 8
        chunk_end = chunk_start + chunk_size
        if chunk_end > len(data):
            fail(f"{label} has a truncated WebP chunk: {path.relative_to(ROOT)}")
        chunk = data[chunk_start:chunk_end]

        if chunk_type == b"VP8X":
            if len(chunk) < 10:
                fail(f"{label} has an invalid WebP VP8X header: {path.relative_to(ROOT)}")
            dimensions = (
                int.from_bytes(chunk[4:7], "little") + 1,
                int.from_bytes(chunk[7:10], "little") + 1,
            )
        elif chunk_type == b"VP8L":
            if len(chunk) < 5 or chunk[0] != 0x2F:
                fail(f"{label} has an invalid lossless WebP header: {path.relative_to(ROOT)}")
            has_image_payload = True
            if dimensions is None:
                size_bits = int.from_bytes(chunk[1:5], "little")
                dimensions = (
                    (size_bits & 0x3FFF) + 1,
                    ((size_bits >> 14) & 0x3FFF) + 1,
                )
        elif chunk_type == b"VP8 ":
            if len(chunk) < 10 or chunk[3:6] != b"\x9d\x01\x2a":
                fail(f"{label} has an invalid lossy WebP header: {path.relative_to(ROOT)}")
            has_image_payload = True
            if dimensions is None:
                dimensions = (
                    struct.unpack("<H", chunk[6:8])[0] & 0x3FFF,
                    struct.unpack("<H", chunk[8:10])[0] & 0x3FFF,
                )

        offset = chunk_end + (chunk_size % 2)

    if offset != len(data):
        fail(f"{label} has invalid WebP chunk padding: {path.relative_to(ROOT)}")
    if not has_image_payload or dimensions is None or min(dimensions) <= 0:
        fail(f"{label} has no valid WebP dimensions: {path.relative_to(ROOT)}")
    return dimensions


def check_rendered_card_sample(card_id: str, card_path: Path, text: str) -> Path:
    sample_relative = Path("samples") / card_id
    sample_dir = card_path.parent / sample_relative
    if not sample_dir.is_dir():
        fail(f"{card_id} Rendered Sample directory is missing: {sample_dir.relative_to(ROOT)}")

    output_name = f"{card_id}.webp"
    prompt_name = f"{card_id}.prompt.txt"
    output_path = require_relative_file(sample_dir, output_name, f"{card_id} Rendered Sample")
    prompt_path = require_relative_file(sample_dir, prompt_name, f"{card_id} exact prompt")

    try:
        prompt_text = prompt_path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        fail(f"{card_id} exact prompt must be UTF-8 text")
    if not prompt_text.strip():
        fail(f"{card_id} exact prompt must be non-empty")
    unresolved = sorted(set(UNRESOLVED_VARIABLE.findall(prompt_text)))
    if unresolved:
        fail(f"{card_id} exact prompt has unresolved variables: {', '.join(unresolved)}")

    sample_section = text.split("## Rendered Sample\n", 1)[1].split(
        "\n## Rights and provenance",
        1,
    )[0]
    fields = {
        field: require_card_sample_field(sample_section, field, card_id)
        for field in CARD_SAMPLE_FIELD_LABELS
    }
    unfinished_fields = [
        field for field, value in fields.items() if re.search(r"<[^>]+>", value)
    ]
    if unfinished_fields:
        fail(
            f"{card_id} Rendered Sample has unfinished template fields: "
            + ", ".join(unfinished_fields)
        )
    if fields["Sample status"] != "Rendered Sample.":
        fail(f"{card_id} Rendered Sample status must be Rendered Sample.")
    if fields["Generation surface"] in {"not_exposed", "`not_exposed`"}:
        fail(f"{card_id} Rendered Sample must name its generation surface")

    generated_at_match = re.fullmatch(r"`([^`]+)`", fields["Generated at"])
    if generated_at_match is None:
        fail(f"{card_id} Rendered Sample generated_at must be a code-formatted UTC timestamp")
    try:
        datetime.strptime(generated_at_match.group(1), "%Y-%m-%dT%H:%M:%SZ")
    except ValueError:
        fail(f"{card_id} Rendered Sample generated_at must use YYYY-MM-DDTHH:MM:SSZ")

    for field in ("Model", "Model version", "Seed", "Request parameters", "Request ID"):
        if fields[field] != "`not_exposed`":
            fail(f"{card_id} Rendered Sample {field} must be `not_exposed`")
    if fields["Profile ID"] != "`null`":
        fail(f"{card_id} Rendered Sample Profile ID must be `null`")
    if fields["Promotion evidence"] != "`false`":
        fail(f"{card_id} Rendered Sample Promotion evidence must be `false`")

    expected_prompt_link = (
        f"[{prompt_name}]({sample_relative.as_posix()}/{prompt_name})"
    )
    if fields["Exact prompt"] != expected_prompt_link:
        fail(f"{card_id} Rendered Sample must link its deterministic exact prompt path")
    expected_output_link = f"{sample_relative.as_posix()}/{output_name}"
    if re.search(
        rf"!\[[^\]\n]+\]\({re.escape(expected_output_link)}\)",
        sample_section,
    ) is None:
        fail(f"{card_id} Rendered Sample must embed its deterministic output path")

    dimensions_match = re.fullmatch(r"`([1-9][0-9]*) x ([1-9][0-9]*)`", fields["Output dimensions"])
    if dimensions_match is None:
        fail(f"{card_id} Rendered Sample Output dimensions must look like `1536 x 1024`")
    recorded_dimensions = tuple(int(value) for value in dimensions_match.groups())
    actual_dimensions = check_webp(output_path, f"{card_id} Rendered Sample")
    if recorded_dimensions != actual_dimensions:
        fail(f"{card_id} Rendered Sample dimensions do not match {output_path.relative_to(ROOT)}")

    checksum_match = re.fullmatch(r"`([0-9a-f]{64})`", fields["Output SHA-256"])
    if checksum_match is None:
        fail(f"{card_id} Rendered Sample Output SHA-256 must be lowercase hexadecimal")
    actual_checksum = hashlib.sha256(output_path.read_bytes()).hexdigest()
    if checksum_match.group(1) != actual_checksum:
        fail(f"{card_id} Rendered Sample SHA-256 does not match {output_path.relative_to(ROOT)}")

    input_derivatives: list[tuple[int, Path]] = []
    allowed_names = {output_name, prompt_name}
    for path in sample_dir.iterdir():
        if not path.is_file():
            fail(f"{card_id} sample directory may contain files only: {path.relative_to(ROOT)}")
        if path.name in allowed_names:
            continue
        input_match = CARD_INPUT_DERIVATIVE.fullmatch(path.name)
        if input_match is None:
            fail(f"{card_id} has an invalid public sample filename: {path.relative_to(ROOT)}")
        input_number = int(input_match.group(1))
        if input_number == 0:
            fail(f"{card_id} supporting input numbering starts at 01")
        input_path = require_relative_file(
            sample_dir,
            path.name,
            f"{card_id} supporting input",
        )
        input_derivatives.append((input_number, input_path))

    input_derivatives.sort(key=lambda value: value[0])
    input_numbers = [number for number, _ in input_derivatives]
    if len(input_numbers) != len(set(input_numbers)):
        fail(f"{card_id} supporting input numbers must be unique")
    for _, input_path in input_derivatives:
        check_webp(input_path, f"{card_id} supporting input")
        input_reference = f"{sample_relative.as_posix()}/{input_path.name}"
        if input_reference not in MARKDOWN_LINK.findall(sample_section):
            fail(f"{card_id} Rendered Sample must link supporting input: {input_reference}")

    return sample_dir


def check_prompt_card(
    entry: object,
    category_ids: set[str],
    recipe_ids: set[str],
) -> tuple[str, Path, Path | None]:
    card = require_keys(entry, REQUIRED_PROMPT_CARD_KEYS, "Prompt Card catalog entry")
    card_id = require_slug(card["id"], "Prompt Card id")
    title = require_nonempty_string(card["title"], f"{card_id} title")
    category = require_slug(card["category"], f"{card_id} category")
    if category not in category_ids:
        fail(f"{card_id} references unknown category: {category}")
    require_slug(card["task_family"], f"{card_id} task_family")

    input_modes = card["input_modes"]
    if not isinstance(input_modes, list) or not input_modes:
        fail(f"{card_id} input_modes must be a non-empty array")
    for index, input_mode in enumerate(input_modes, start=1):
        require_nonempty_string(input_mode, f"{card_id} input_mode {index}")
    if len(input_modes) != len(set(input_modes)):
        fail(f"{card_id} input_modes must be unique")
    invalid_modes = sorted(set(input_modes) - ALLOWED_INPUT_MODES)
    if invalid_modes:
        fail(f"{card_id} has invalid input_modes: {', '.join(invalid_modes)}")

    require_nonempty_string(card["output_type"], f"{card_id} output_type")
    aspect_ratio = require_nonempty_string(card["aspect_ratio"], f"{card_id} aspect_ratio")
    if not re.fullmatch(r"[1-9][0-9]*:[1-9][0-9]*", aspect_ratio):
        fail(f"{card_id} aspect_ratio must look like 3:2")
    if card["text_density"] not in ALLOWED_TEXT_DENSITY:
        fail(f"{card_id} has invalid text_density")

    tags = card["tags"]
    if not isinstance(tags, list) or len(tags) < 2:
        fail(f"{card_id} tags must contain at least two values")
    for index, tag in enumerate(tags, start=1):
        require_slug(tag, f"{card_id} tag {index}")
    if len(tags) != len(set(tags)):
        fail(f"{card_id} tags must be unique")

    if card["source_posture"] not in ALLOWED_POSTURES:
        fail(f"{card_id} has invalid source_posture")
    if card["rights"] != "project-authored":
        fail(f"{card_id} rights must be project-authored in this release")
    sample_status = card["sample_status"]
    if sample_status not in ALLOWED_CARD_SAMPLE_STATUS:
        fail(f"{card_id} sample_status must be placeholder or rendered")

    linked_recipe = card["linked_recipe"]
    if linked_recipe is not None:
        linked_recipe = require_slug(linked_recipe, f"{card_id} linked_recipe")
        if linked_recipe not in recipe_ids:
            fail(f"{card_id} links to unknown Recipe: {linked_recipe}")

    card_path_value = require_nonempty_string(card["path"], f"{card_id} path")
    card_path = require_relative_file(ROOT, card_path_value, f"{card_id} Prompt Card")
    expected_path = Path("prompt-cards") / category / f"{card_id}.md"
    if card_path.relative_to(ROOT) != expected_path:
        fail(f"{card_id} path must be {expected_path.as_posix()}")
    check_source_reference(card, card_path.parent, card_id)

    text = card_path.read_text(encoding="utf-8")
    if not text.startswith(f"# {title}\n"):
        fail(f"{card_id} Prompt Card must start with its catalog title")
    sample_heading = CARD_SAMPLE_HEADINGS[sample_status]
    other_sample_heading = CARD_SAMPLE_HEADINGS[
        "rendered" if sample_status == "placeholder" else "placeholder"
    ]
    heading_positions: list[int] = []
    required_headings = (
        *REQUIRED_CARD_HEADINGS_BEFORE_SAMPLE,
        sample_heading,
        "## Rights and provenance",
    )
    for heading in required_headings:
        marker = f"{heading}\n"
        if text.count(marker) != 1:
            fail(f"{card_id} Prompt Card must contain heading exactly once: {heading}")
        heading_positions.append(text.index(marker))
    if f"{other_sample_heading}\n" in text:
        fail(f"{card_id} Prompt Card sample heading does not match sample_status")
    if heading_positions != sorted(heading_positions):
        fail(f"{card_id} Prompt Card headings are out of order")

    prompt_blocks = re.findall(r"```text\n(.*?)\n```", text, re.DOTALL)
    if len(prompt_blocks) != 1:
        fail(f"{card_id} Prompt Card must contain exactly one fenced text prompt")
    prompt_variables = set(re.findall(r"\{([A-Z][A-Z0-9_]*)\}", prompt_blocks[0]))
    variables_section = text.split("## Variables\n", 1)[1].split(
        "\n## Negative constraints",
        1,
    )[0]
    declared_variables = set(
        re.findall(r"`\{([A-Z][A-Z0-9_]*)\}`", variables_section)
    )
    if prompt_variables != declared_variables:
        fail(
            f"{card_id} prompt and Variables section differ: "
            f"prompt={sorted(prompt_variables)}, declared={sorted(declared_variables)}"
        )
    sample_dir: Path | None = None
    expected_sample_dir = card_path.parent / "samples" / card_id
    if sample_status == "placeholder":
        if "Sample status: Placeholder Preview." not in text:
            fail(f"{card_id} must visibly label its Placeholder Preview")
        if expected_sample_dir.exists():
            fail(f"{card_id} placeholder must not have a public sample directory")
    else:
        sample_dir = check_rendered_card_sample(card_id, card_path, text)
    if "[TODO:" in text:
        fail(f"{card_id} Prompt Card contains an unfinished TODO")
    return card_id, card_path, sample_dir


def check_asset(base: Path, value: object, label: str) -> Path:
    asset = require_keys(value, REQUIRED_ASSET_KEYS, label)
    asset_path_value = require_nonempty_string(asset["path"], f"{label} path")
    asset_path = require_relative_file(base, asset_path_value, f"{label} asset")

    checksum = asset["sha256"]
    if not isinstance(checksum, str) or not SHA256.fullmatch(checksum):
        fail(f"{label} sha256 must be 64 lowercase hexadecimal characters")
    actual_checksum = hashlib.sha256(asset_path.read_bytes()).hexdigest()
    if actual_checksum != checksum:
        fail(f"{label} sha256 does not match {asset_path.relative_to(ROOT)}")

    if asset["format"] != "png":
        fail(f"{label} format must be png")
    for dimension in ("width", "height"):
        if (
            isinstance(asset[dimension], bool)
            or not isinstance(asset[dimension], int)
            or asset[dimension] <= 0
        ):
            fail(f"{label} {dimension} must be a positive integer")

    header = asset_path.read_bytes()[:24]
    if header[:8] != PNG_SIGNATURE:
        fail(f"{label} is not a PNG: {asset_path.relative_to(ROOT)}")
    if len(header) < 24 or header[8:12] != b"\x00\x00\x00\r" or header[12:16] != b"IHDR":
        fail(f"{label} has an invalid PNG IHDR: {asset_path.relative_to(ROOT)}")
    actual_width, actual_height = struct.unpack(">II", header[16:24])
    if (actual_width, actual_height) != (asset["width"], asset["height"]):
        fail(f"{label} dimensions do not match {asset_path.relative_to(ROOT)}")
    return asset_path


def check_evidence(
    record: dict,
    base: Path,
    evidence_path: Path,
    readme_text: str,
) -> None:
    relative_evidence = evidence_path.relative_to(ROOT)
    evidence = require_keys(
        load_json(evidence_path),
        REQUIRED_EVIDENCE_KEYS,
        str(relative_evidence),
    )
    if evidence["schema_version"] != 1:
        fail(f"{relative_evidence} schema_version must be 1")
    if evidence["recipe_id"] != record["id"]:
        fail(f"evidence recipe_id mismatch for {record['id']}")
    if evidence["recipe_record_version"] != record["record_version"]:
        fail(f"evidence recipe_record_version mismatch for {record['id']}")

    runs = evidence["runs"]
    if not isinstance(runs, list):
        fail(f"evidence runs must be a list for {record['id']}")
    expected_status = "recorded" if runs else "placeholder"
    if evidence["status"] != expected_status:
        fail(f"evidence status must be {expected_status} for {record['id']}")
    if evidence["status"] != record["evidence_status"]:
        fail(f"evidence status mismatch for {record['id']}")

    profile_ids = set(record["profiles"].values())
    seen_run_ids: set[str] = set()
    for index, value in enumerate(runs, start=1):
        run_label = f"{relative_evidence} run {index}"
        run = require_keys(value, REQUIRED_RUN_KEYS, run_label)

        run_id = require_nonempty_string(run["id"], f"{run_label} id")
        if run_id in seen_run_ids:
            fail(f"duplicate run id in {relative_evidence}: {run_id}")
        seen_run_ids.add(run_id)
        for key in (
            "kind",
            "generated_at",
            "surface",
            "model",
            "model_version",
            "request_id",
        ):
            require_nonempty_string(run[key], f"{run_label} {key}")

        seed = run["seed"]
        if (
            isinstance(seed, bool)
            or not isinstance(seed, (int, str))
            or (isinstance(seed, str) and not seed.strip())
        ):
            fail(f"{run_label} seed must be an integer or non-empty string")
        if not isinstance(run["request_parameters"], dict) and run["request_parameters"] != "not_exposed":
            fail(f"{run_label} request_parameters must be an object or not_exposed")

        prompt_file_value = require_nonempty_string(
            run["prompt_file"],
            f"{run_label} prompt_file",
        )
        prompt_path = require_relative_file(base, prompt_file_value, f"{run_label} prompt file")
        try:
            prompt_text = prompt_path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            fail(f"{run_label} prompt file must be UTF-8 text")
        if not prompt_text.strip():
            fail(f"{run_label} prompt file must contain the exact prompt")

        profile_id = run["profile_id"]
        if profile_id is not None:
            profile_id = require_nonempty_string(profile_id, f"{run_label} profile_id")
            if profile_id not in profile_ids:
                fail(f"{run_label} profile_id does not match recipe.json")

        inputs = run["inputs"]
        if not isinstance(inputs, list):
            fail(f"{run_label} inputs must be an array")
        for input_index, input_value in enumerate(inputs, start=1):
            input_label = f"{run_label} input {input_index}"
            input_asset = require_keys(
                input_value,
                REQUIRED_ASSET_KEYS | {"authorization"},
                input_label,
            )
            require_nonempty_string(
                input_asset["authorization"],
                f"{input_label} authorization",
            )
            check_asset(base, input_asset, input_label)

        output_path = check_asset(base, run["output"], f"{run_label} output")

        inspection = require_keys(
            run["inspection"],
            {"status", "notes"},
            f"{run_label} inspection",
        )
        require_nonempty_string(
            inspection["status"],
            f"{run_label} inspection status",
        )
        notes = inspection["notes"]
        if not isinstance(notes, list) or not notes:
            fail(f"{run_label} inspection notes must be a non-empty array")
        for note_index, note in enumerate(notes, start=1):
            require_nonempty_string(
                note,
                f"{run_label} inspection note {note_index}",
            )

        for key in ("promotion_evidence", "featured_in_readme"):
            if not isinstance(run[key], bool):
                fail(f"{run_label} {key} must be a boolean")

        rights = require_keys(
            run["rights"],
            REQUIRED_RIGHTS_KEYS,
            f"{run_label} rights",
        )
        for key in REQUIRED_RIGHTS_KEYS:
            require_nonempty_string(rights[key], f"{run_label} rights {key}")

        if run["promotion_evidence"]:
            if run["kind"] == "supporting-input-generation":
                fail(f"{run_label} supporting input cannot be promotion evidence")
            if profile_id is None:
                fail(f"{run_label} promotion evidence requires a profile_id")
            hidden = sorted(
                key for key in PROMOTION_METADATA_KEYS if run[key] == "not_exposed"
            )
            if hidden:
                fail(
                    f"{run_label} promotion evidence has not_exposed metadata: "
                    f"{', '.join(hidden)}"
                )

        if run["featured_in_readme"]:
            output_reference = output_path.relative_to(ROOT).as_posix()
            evidence_reference = relative_evidence.as_posix()
            for reference in (output_reference, evidence_reference):
                if reference not in readme_text:
                    fail(f"README.md must reference featured evidence path: {reference}")


def check_skill() -> None:
    skill = ROOT / "skills/image-recipe-library/SKILL.md"
    text = skill.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        fail("skill frontmatter is missing")
    parts = text.split("---\n", 2)
    if len(parts) != 3:
        fail("skill frontmatter is not closed")
    frontmatter: dict[str, str] = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            fail(f"invalid skill frontmatter line: {line}")
        key, value = line.split(":", 1)
        frontmatter[key.strip()] = value.strip()
    if set(frontmatter) != {"name", "description"}:
        fail("skill frontmatter must contain only name and description")
    name = frontmatter["name"]
    description = frontmatter["description"]
    if name != "image-recipe-library":
        fail("skill name is missing or incorrect")
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name) or len(name) > 64:
        fail("skill name is not valid hyphen-case")
    if not description or len(description) > 1024 or "<" in description or ">" in description:
        fail("skill description is missing or invalid")
    if "[TODO:" in parts[2]:
        fail("skill instructions contain an unfinished TODO placeholder")

    expected = Path("../../skills/image-recipe-library")
    for link_name in (
        ".agents/skills/image-recipe-library",
        ".claude/skills/image-recipe-library",
    ):
        link = ROOT / link_name
        if not link.is_symlink():
            fail(f"runtime discovery path is not a symlink: {link_name}")
        if Path(link.readlink()) != expected:
            fail(f"runtime discovery link has unexpected target: {link_name}")


def check_local_markdown_links() -> None:
    ignored_parts = {".agents", ".claude", ".git"}
    for markdown in ROOT.rglob("*.md"):
        relative = markdown.relative_to(ROOT)
        if ignored_parts.intersection(relative.parts):
            continue
        text = markdown.read_text(encoding="utf-8")
        link_text = re.sub(r"```.*?```", "", text, flags=re.DOTALL)
        for target in MARKDOWN_LINK.findall(link_text):
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            local_target = target.split("#", 1)[0]
            if not local_target:
                continue
            path = (markdown.parent / local_target).resolve()
            try:
                path.relative_to(ROOT)
            except ValueError:
                fail(f"Markdown link escapes repository in {relative}: {target}")
            if not path.exists():
                fail(f"broken Markdown link in {relative}: {target}")


def main() -> None:
    for required_file in ("LICENSE", "THIRD_PARTY_NOTICES.md"):
        if not (ROOT / required_file).is_file():
            fail(f"missing repository rights file: {required_file}")

    catalog = load_json(ROOT / "catalog.json")
    if catalog.get("schema_version") != 1:
        fail("catalog schema_version must be 1")

    categories = catalog.get("categories")
    if not isinstance(categories, list) or not categories:
        fail("catalog categories must be a non-empty list")
    if len(categories) != EXPECTED_CATEGORY_COUNT:
        fail(f"catalog must contain exactly {EXPECTED_CATEGORY_COUNT} categories")
    category_ids: set[str] = set()
    category_titles: set[str] = set()
    for value in categories:
        category = require_keys(value, REQUIRED_CATEGORY_KEYS, "catalog category")
        category_id = require_slug(category["id"], "catalog category id")
        category_title = require_nonempty_string(
            category["title"],
            f"{category_id} category title",
        )
        if category_id in category_ids:
            fail(f"duplicate category id: {category_id}")
        if category_title in category_titles:
            fail(f"duplicate category title: {category_title}")
        category_ids.add(category_id)
        category_titles.add(category_title)

    if category_ids != set(EXPECTED_CARDS_BY_CATEGORY):
        fail("catalog categories differ from the expected Prompt Card distribution")

    recipes = catalog.get("recipes")
    if not isinstance(recipes, list) or not recipes:
        fail("catalog recipes must be a non-empty list")
    if len(recipes) != EXPECTED_RECIPE_COUNT:
        fail(f"catalog must contain exactly {EXPECTED_RECIPE_COUNT} Recipes")

    readme_text = (ROOT / "README.md").read_text(encoding="utf-8")
    seen_recipe_ids: set[str] = set()
    seen_recipe_paths: set[Path] = set()
    recipes_by_category = {category_id: 0 for category_id in category_ids}
    for entry_value in recipes:
        entry = require_keys(
            entry_value,
            REQUIRED_CATALOG_RECIPE_KEYS,
            "Recipe catalog entry",
        )
        category = require_slug(entry["category"], f"{entry.get('id', 'Recipe')} category")
        if category not in category_ids:
            fail(f"Recipe references unknown category: {category}")
        recipe_path = require_relative_file(ROOT, entry.get("path", ""), "Recipe record")
        relative_recipe_path = recipe_path.relative_to(ROOT)
        if relative_recipe_path in seen_recipe_paths:
            fail(f"duplicate Recipe path: {relative_recipe_path}")
        seen_recipe_paths.add(relative_recipe_path)
        record = load_json(recipe_path)
        missing = REQUIRED_RECIPE_KEYS - record.keys()
        if missing:
            fail(f"{recipe_path.relative_to(ROOT)} missing keys: {', '.join(sorted(missing))}")
        if record["schema_version"] != 1:
            fail(f"{record['id']} schema_version must be 1")
        if record["id"] != entry.get("id"):
            fail(f"catalog id does not match {recipe_path.relative_to(ROOT)}")
        if record["title"] != entry["title"]:
            fail(f"catalog title does not match {recipe_path.relative_to(ROOT)}")
        if record["task_family"] != entry["task_family"]:
            fail(f"catalog task_family does not match {recipe_path.relative_to(ROOT)}")
        if record["id"] in seen_recipe_ids:
            fail(f"duplicate Recipe id: {record['id']}")
        seen_recipe_ids.add(record["id"])
        recipes_by_category[category] += 1
        if record["source_posture"] not in ALLOWED_POSTURES:
            fail(f"{record['id']} has invalid source_posture")
        if record["evidence_status"] not in ALLOWED_EVIDENCE:
            fail(f"{record['id']} has invalid evidence_status")
        profiles = record["profiles"]
        if not isinstance(profiles, dict) or set(profiles) != {
            "conversational",
            "gpt-image-2-api",
        }:
            fail(f"{record['id']} must declare both version-one profiles")
        if not all(isinstance(value, str) and value for value in profiles.values()):
            fail(f"{record['id']} profile ids must be non-empty strings")

        base = recipe_path.parent
        check_source_reference(record, base, record["id"])
        require_relative_file(base, record["recipe_markdown"], "Recipe Markdown")
        evidence_path = require_relative_file(base, record["evidence_manifest"], "evidence manifest")
        check_evidence(record, base, evidence_path, readme_text)

    orphan_recipe_paths = {
        path.relative_to(ROOT)
        for path in (ROOT / "recipes").glob("*/recipe.json")
    } - seen_recipe_paths
    if orphan_recipe_paths:
        fail(
            "Recipe records missing from catalog: "
            + ", ".join(sorted(path.as_posix() for path in orphan_recipe_paths))
        )

    missing_recipe_categories = sorted(
        category_id
        for category_id, count in recipes_by_category.items()
        if count == 0
    )
    if missing_recipe_categories:
        fail(
            "catalog categories without a Recipe: "
            + ", ".join(missing_recipe_categories)
        )

    prompt_cards = catalog.get("prompt_cards")
    if not isinstance(prompt_cards, list) or not prompt_cards:
        fail("catalog prompt_cards must be a non-empty list")
    if len(prompt_cards) != EXPECTED_PROMPT_CARD_COUNT:
        fail(f"catalog must contain exactly {EXPECTED_PROMPT_CARD_COUNT} Prompt Cards")
    seen_card_ids: set[str] = set()
    seen_card_paths: set[Path] = set()
    seen_card_sample_dirs: set[Path] = set()
    cards_by_category = {category_id: 0 for category_id in category_ids}
    prompt_index_text = (ROOT / "prompt-cards/README.md").read_text(encoding="utf-8")
    for entry in prompt_cards:
        card_id, card_path, sample_dir = check_prompt_card(
            entry,
            category_ids,
            seen_recipe_ids,
        )
        relative_card_path = card_path.relative_to(ROOT)
        if card_id in seen_card_ids:
            fail(f"duplicate Prompt Card id: {card_id}")
        if relative_card_path in seen_card_paths:
            fail(f"duplicate Prompt Card path: {relative_card_path}")
        seen_card_ids.add(card_id)
        seen_card_paths.add(relative_card_path)
        if sample_dir is not None:
            seen_card_sample_dirs.add(sample_dir.relative_to(ROOT))
        cards_by_category[entry["category"]] += 1
        index_reference = relative_card_path.relative_to("prompt-cards").as_posix()
        if index_reference not in prompt_index_text:
            fail(f"prompt-cards/README.md must reference: {index_reference}")

    orphan_card_paths = {
        path.relative_to(ROOT)
        for path in (ROOT / "prompt-cards").glob("*/*.md")
    } - seen_card_paths
    if orphan_card_paths:
        fail(
            "Prompt Cards missing from catalog: "
            + ", ".join(sorted(path.as_posix() for path in orphan_card_paths))
        )

    unexpected_card_sample_entries = {
        path.relative_to(ROOT)
        for path in (ROOT / "prompt-cards").glob("*/samples/*")
    } - seen_card_sample_dirs
    if unexpected_card_sample_entries:
        fail(
            "Prompt Card sample paths do not match rendered catalog entries: "
            + ", ".join(
                sorted(path.as_posix() for path in unexpected_card_sample_entries)
            )
        )

    prompt_card_json = sorted(
        path.relative_to(ROOT).as_posix()
        for path in (ROOT / "prompt-cards").rglob("*.json")
    )
    if prompt_card_json:
        fail("Prompt Cards must not use JSON evidence records: " + ", ".join(prompt_card_json))

    card_category_mismatches = sorted(
        f"{category_id} ({count}/{EXPECTED_CARDS_BY_CATEGORY[category_id]})"
        for category_id, count in cards_by_category.items()
        if count != EXPECTED_CARDS_BY_CATEGORY[category_id]
    )
    if card_category_mismatches:
        fail(
            "catalog category Prompt Card counts differ from the expected distribution: "
            + ", ".join(card_category_mismatches)
        )

    check_skill()
    check_local_markdown_links()
    print(
        f"Check passed: {len(prompt_cards)} Prompt Cards, {len(recipes)} Recipes, "
        "and portable skill structure are valid."
    )


if __name__ == "__main__":
    main()
