#!/usr/bin/env python3

import hashlib
import json
import re
import struct
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
REQUIRED_RECIPE_KEYS = {
    "schema_version",
    "id",
    "record_version",
    "status",
    "title",
    "task_family",
    "source_posture",
    "source_record",
    "recipe_markdown",
    "evidence_manifest",
    "profiles",
    "evidence_status",
}
ALLOWED_POSTURES = {"attributed-rebuild", "translation", "frozen-source"}
ALLOWED_EVIDENCE = {"placeholder", "recorded"}
REQUIRED_EVIDENCE_KEYS = {
    "schema_version",
    "recipe_id",
    "recipe_record_version",
    "status",
    "runs",
}
REQUIRED_RUN_KEYS = {
    "id",
    "kind",
    "generated_at",
    "surface",
    "model",
    "model_version",
    "seed",
    "request_parameters",
    "request_id",
    "prompt_file",
    "profile_id",
    "inputs",
    "output",
    "inspection",
    "promotion_evidence",
    "featured_in_readme",
    "rights",
}
REQUIRED_ASSET_KEYS = {"path", "sha256", "width", "height", "format"}
REQUIRED_RIGHTS_KEYS = {
    "input_rights",
    "creator_or_authorized_licensor",
    "license",
}
PROMOTION_METADATA_KEYS = {
    "model",
    "model_version",
    "seed",
    "request_parameters",
    "request_id",
}
MARKDOWN_LINK = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
SHA256 = re.compile(r"[0-9a-f]{64}")
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"


def fail(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"missing file: {path.relative_to(ROOT)}")
    except json.JSONDecodeError as error:
        fail(f"invalid JSON in {path.relative_to(ROOT)}: {error}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path.relative_to(ROOT)}")
    return value


def require_relative_file(base: Path, value: str, label: str) -> Path:
    path = (base / value).resolve()
    try:
        path.relative_to(ROOT)
    except ValueError:
        fail(f"{label} escapes repository: {value}")
    if not path.is_file():
        fail(f"missing {label}: {path.relative_to(ROOT)}")
    return path


def require_keys(value: object, required: set[str], label: str) -> dict:
    if not isinstance(value, dict):
        fail(f"{label} must be an object")
    missing = required - value.keys()
    if missing:
        fail(f"{label} missing keys: {', '.join(sorted(missing))}")
    return value


def require_nonempty_string(value: object, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        fail(f"{label} must be a non-empty string")
    return value


def check_asset(base: Path, value: object, label: str) -> Path:
    asset = require_keys(value, REQUIRED_ASSET_KEYS, label)
    asset_path_value = require_nonempty_string(asset["path"], f"{label} path")
    asset_path = require_relative_file(base, asset_path_value, f"{label} asset")

    checksum = asset["sha256"]
    if not isinstance(checksum, str) or not SHA256.fullmatch(checksum):
        fail(f"{label} sha256 must be 64 lowercase hexadecimal characters")
    actual_checksum = hashlib.sha256(asset_path.read_bytes()).hexdigest()
    if actual_checksum != checksum:
        fail(f"{label} sha256 does not match {asset_path.relative_to(ROOT)}")

    if asset["format"] != "png":
        fail(f"{label} format must be png")
    for dimension in ("width", "height"):
        if (
            isinstance(asset[dimension], bool)
            or not isinstance(asset[dimension], int)
            or asset[dimension] <= 0
        ):
            fail(f"{label} {dimension} must be a positive integer")

    header = asset_path.read_bytes()[:24]
    if header[:8] != PNG_SIGNATURE:
        fail(f"{label} is not a PNG: {asset_path.relative_to(ROOT)}")
    if len(header) < 24 or header[8:12] != b"\x00\x00\x00\r" or header[12:16] != b"IHDR":
        fail(f"{label} has an invalid PNG IHDR: {asset_path.relative_to(ROOT)}")
    actual_width, actual_height = struct.unpack(">II", header[16:24])
    if (actual_width, actual_height) != (asset["width"], asset["height"]):
        fail(f"{label} dimensions do not match {asset_path.relative_to(ROOT)}")
    return asset_path


def check_evidence(
    record: dict,
    base: Path,
    evidence_path: Path,
    readme_text: str,
) -> None:
    relative_evidence = evidence_path.relative_to(ROOT)
    evidence = require_keys(
        load_json(evidence_path),
        REQUIRED_EVIDENCE_KEYS,
        str(relative_evidence),
    )
    if evidence["schema_version"] != 1:
        fail(f"{relative_evidence} schema_version must be 1")
    if evidence["recipe_id"] != record["id"]:
        fail(f"evidence recipe_id mismatch for {record['id']}")
    if evidence["recipe_record_version"] != record["record_version"]:
        fail(f"evidence recipe_record_version mismatch for {record['id']}")

    runs = evidence["runs"]
    if not isinstance(runs, list):
        fail(f"evidence runs must be a list for {record['id']}")
    expected_status = "recorded" if runs else "placeholder"
    if evidence["status"] != expected_status:
        fail(f"evidence status must be {expected_status} for {record['id']}")
    if evidence["status"] != record["evidence_status"]:
        fail(f"evidence status mismatch for {record['id']}")

    profile_ids = set(record["profiles"].values())
    seen_run_ids: set[str] = set()
    for index, value in enumerate(runs, start=1):
        run_label = f"{relative_evidence} run {index}"
        run = require_keys(value, REQUIRED_RUN_KEYS, run_label)

        run_id = require_nonempty_string(run["id"], f"{run_label} id")
        if run_id in seen_run_ids:
            fail(f"duplicate run id in {relative_evidence}: {run_id}")
        seen_run_ids.add(run_id)
        for key in (
            "kind",
            "generated_at",
            "surface",
            "model",
            "model_version",
            "request_id",
        ):
            require_nonempty_string(run[key], f"{run_label} {key}")

        seed = run["seed"]
        if (
            isinstance(seed, bool)
            or not isinstance(seed, (int, str))
            or (isinstance(seed, str) and not seed.strip())
        ):
            fail(f"{run_label} seed must be an integer or non-empty string")
        if not isinstance(run["request_parameters"], dict) and run["request_parameters"] != "not_exposed":
            fail(f"{run_label} request_parameters must be an object or not_exposed")

        prompt_file_value = require_nonempty_string(
            run["prompt_file"],
            f"{run_label} prompt_file",
        )
        prompt_path = require_relative_file(base, prompt_file_value, f"{run_label} prompt file")
        try:
            prompt_text = prompt_path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            fail(f"{run_label} prompt file must be UTF-8 text")
        if not prompt_text.strip():
            fail(f"{run_label} prompt file must contain the exact prompt")

        profile_id = run["profile_id"]
        if profile_id is not None:
            profile_id = require_nonempty_string(profile_id, f"{run_label} profile_id")
            if profile_id not in profile_ids:
                fail(f"{run_label} profile_id does not match recipe.json")

        inputs = run["inputs"]
        if not isinstance(inputs, list):
            fail(f"{run_label} inputs must be an array")
        for input_index, input_value in enumerate(inputs, start=1):
            input_label = f"{run_label} input {input_index}"
            input_asset = require_keys(
                input_value,
                REQUIRED_ASSET_KEYS | {"authorization"},
                input_label,
            )
            require_nonempty_string(
                input_asset["authorization"],
                f"{input_label} authorization",
            )
            check_asset(base, input_asset, input_label)

        output_path = check_asset(base, run["output"], f"{run_label} output")

        inspection = require_keys(
            run["inspection"],
            {"status", "notes"},
            f"{run_label} inspection",
        )
        require_nonempty_string(
            inspection["status"],
            f"{run_label} inspection status",
        )
        notes = inspection["notes"]
        if not isinstance(notes, list) or not notes:
            fail(f"{run_label} inspection notes must be a non-empty array")
        for note_index, note in enumerate(notes, start=1):
            require_nonempty_string(
                note,
                f"{run_label} inspection note {note_index}",
            )

        for key in ("promotion_evidence", "featured_in_readme"):
            if not isinstance(run[key], bool):
                fail(f"{run_label} {key} must be a boolean")

        rights = require_keys(
            run["rights"],
            REQUIRED_RIGHTS_KEYS,
            f"{run_label} rights",
        )
        for key in REQUIRED_RIGHTS_KEYS:
            require_nonempty_string(rights[key], f"{run_label} rights {key}")

        if run["promotion_evidence"]:
            if run["kind"] == "supporting-input-generation":
                fail(f"{run_label} supporting input cannot be promotion evidence")
            if profile_id is None:
                fail(f"{run_label} promotion evidence requires a profile_id")
            hidden = sorted(
                key for key in PROMOTION_METADATA_KEYS if run[key] == "not_exposed"
            )
            if hidden:
                fail(
                    f"{run_label} promotion evidence has not_exposed metadata: "
                    f"{', '.join(hidden)}"
                )

        if run["featured_in_readme"]:
            output_reference = output_path.relative_to(ROOT).as_posix()
            evidence_reference = relative_evidence.as_posix()
            for reference in (output_reference, evidence_reference):
                if reference not in readme_text:
                    fail(f"README.md must reference featured evidence path: {reference}")


def check_skill() -> None:
    skill = ROOT / "skills/image-recipe-library/SKILL.md"
    text = skill.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        fail("skill frontmatter is missing")
    parts = text.split("---\n", 2)
    if len(parts) != 3:
        fail("skill frontmatter is not closed")
    frontmatter: dict[str, str] = {}
    for line in parts[1].splitlines():
        if ":" not in line:
            fail(f"invalid skill frontmatter line: {line}")
        key, value = line.split(":", 1)
        frontmatter[key.strip()] = value.strip()
    if set(frontmatter) != {"name", "description"}:
        fail("skill frontmatter must contain only name and description")
    name = frontmatter["name"]
    description = frontmatter["description"]
    if name != "image-recipe-library":
        fail("skill name is missing or incorrect")
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name) or len(name) > 64:
        fail("skill name is not valid hyphen-case")
    if not description or len(description) > 1024 or "<" in description or ">" in description:
        fail("skill description is missing or invalid")
    if "[TODO:" in parts[2]:
        fail("skill instructions contain an unfinished TODO placeholder")

    expected = Path("../../skills/image-recipe-library")
    for link_name in (
        ".agents/skills/image-recipe-library",
        ".claude/skills/image-recipe-library",
    ):
        link = ROOT / link_name
        if not link.is_symlink():
            fail(f"runtime discovery path is not a symlink: {link_name}")
        if Path(link.readlink()) != expected:
            fail(f"runtime discovery link has unexpected target: {link_name}")


def check_local_markdown_links() -> None:
    ignored_parts = {".agents", ".claude", ".git"}
    for markdown in ROOT.rglob("*.md"):
        relative = markdown.relative_to(ROOT)
        if ignored_parts.intersection(relative.parts):
            continue
        text = markdown.read_text(encoding="utf-8")
        for target in MARKDOWN_LINK.findall(text):
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            local_target = target.split("#", 1)[0]
            if not local_target:
                continue
            path = (markdown.parent / local_target).resolve()
            try:
                path.relative_to(ROOT)
            except ValueError:
                fail(f"Markdown link escapes repository in {relative}: {target}")
            if not path.exists():
                fail(f"broken Markdown link in {relative}: {target}")


def main() -> None:
    for required_file in ("LICENSE", "THIRD_PARTY_NOTICES.md"):
        if not (ROOT / required_file).is_file():
            fail(f"missing repository rights file: {required_file}")

    catalog = load_json(ROOT / "catalog.json")
    if catalog.get("schema_version") != 1:
        fail("catalog schema_version must be 1")

    recipes = catalog.get("recipes")
    if not isinstance(recipes, list) or not recipes:
        fail("catalog recipes must be a non-empty list")

    readme_text = (ROOT / "README.md").read_text(encoding="utf-8")
    seen_ids: set[str] = set()
    for entry in recipes:
        recipe_path = require_relative_file(ROOT, entry.get("path", ""), "Recipe record")
        record = load_json(recipe_path)
        missing = REQUIRED_RECIPE_KEYS - record.keys()
        if missing:
            fail(f"{recipe_path.relative_to(ROOT)} missing keys: {', '.join(sorted(missing))}")
        if record["schema_version"] != 1:
            fail(f"{record['id']} schema_version must be 1")
        if record["id"] != entry.get("id"):
            fail(f"catalog id does not match {recipe_path.relative_to(ROOT)}")
        if record["id"] in seen_ids:
            fail(f"duplicate Recipe id: {record['id']}")
        seen_ids.add(record["id"])
        if record["source_posture"] not in ALLOWED_POSTURES:
            fail(f"{record['id']} has invalid source_posture")
        if record["evidence_status"] not in ALLOWED_EVIDENCE:
            fail(f"{record['id']} has invalid evidence_status")
        profiles = record["profiles"]
        if not isinstance(profiles, dict) or set(profiles) != {
            "conversational",
            "gpt-image-2-api",
        }:
            fail(f"{record['id']} must declare both version-one profiles")
        if not all(isinstance(value, str) and value for value in profiles.values()):
            fail(f"{record['id']} profile ids must be non-empty strings")

        base = recipe_path.parent
        require_relative_file(base, record["source_record"], "source record")
        require_relative_file(base, record["recipe_markdown"], "Recipe Markdown")
        evidence_path = require_relative_file(base, record["evidence_manifest"], "evidence manifest")
        check_evidence(record, base, evidence_path, readme_text)

    check_skill()
    check_local_markdown_links()
    print(f"Check passed: {len(recipes)} Recipes and portable skill structure are valid.")


if __name__ == "__main__":
    main()
